# Registry trust
registry=https://registry.npmjs.org/
strict-ssl=true

# Deterministic dependency state
package-lock=true
lockfile-version=3
save-exact=true
omit-lockfile-registry-resolved=false
engine-strict=true
strict-peer-deps=true
legacy-peer-deps=false
bin-links=false

# Restrict dependency sources to registry versions
allow-directory=none
allow-file=none
allow-git=none
allow-remote=none
min-release-age=7

# Deny lifecycle scripts by default
ignore-scripts=true
strict-allow-scripts=true
allow-scripts-pin=true
dangerously-allow-all-scripts=false

# Security checks and quiet nonessential output
audit=true
audit-level=high
force=false
fund=false
update-notifier=false
